import random
from pywebio import start_server
from pywebio.input import *
from pywebio.output import *
from pywebio.session import *


# List of developer motivation messages
messages = [
    "Debugging is a part of learning, not a sign of failure.",
    "Errors are clues, not roadblocks.",
    "Great developers are built through patience and pratice",
    "Your future self will thank you for practicing today"]

def get_message(_):
    clear()

    put_html(
        '<p align="left>'
        '<h2>DevMotive</h2>'
        '</p>'
    )

    put_text("Your daily motivation for coding:")
    put_text("")
    
    message = random.choice(messages)
     
    style(put_text(message), 'color:blue; font-size: 30px')
    
    put_text("")
    
    put_buttons(
        [dict(label="Show Motivation", value='motivation', color='outline-success')],
        onclick=get_message
    )

def app():
    put_html(
        '<p align="left">'
        '<h2>💻 DevMotive</h2>'
        '</p>'

    )


put_buttons(
    [dict(label="Show Motivation", value='motivation', color='outline-success')],
    onclick = get_message
)
hold()

if __name__ == "__main__":
    start_server(app, port=8080, debug=True)

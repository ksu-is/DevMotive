import random
from turtle import colormode
from pywebio import start_server
from pywebio.input import *
from pywebio.output import *
from pywebio.session import *


# List of developer motivation messages
messages = [
    #added new  messages
    "Debugging is a part of learning, not a sign of failure.",
    "Errors are clues, not roadblocks.",
    "Great developers are built through patience and pratice",
    "Your future self will thank you for practicing today"
""
    ]

    #adding programming quotes
quotes = [
    "“Programming isn’t about what you know; it’s about what you can figure out.” – Chris Pine, Learn to Program",
"“You might not think that programmers are artists, but programming is an extremely creative profession. It’s logic-based creativity.” – John Romero, video game developer and programmer",
"“Every great developer you know got there by solving problems they were unqualified to solve until they actually did it.” – Patrick McKenzie, software engineer",
"“Learning to write programs stretches your mind, and helps you think better, creates a way of thinking about things that I think is helpful in all domains.” – Bill Gates, Microsoft co-founder"
]

challenges = [
    "Create a program that counts the vowels in a sentence.",
    "Write a function that finds the largest number in a list.",
    "Create a program that reverses a string.",
    "Build a simple calculator that can add, subtract, multiply, and divide."
]

tips_advice = ["Read the error message carefully",
]


    

def button_click(btn):
    if btn == 'motivation':
        get_message(btn)
    elif btn == 'quote':
        get_quote(btn)
    elif btn == 'challenge':
        get_challenge(btn)
    elif btn == "tips_advice":
        get_tips_advice(btn)

def get_tips_advice(_):
    clear()
    show_buttons()

    put_html(
        '<p align="left>'
        '<h2>DevMotive Tips and Advice</h2>'
        '</p>'
    )

    put_text("We think you should know these cool coding tips to help on your journey as a new developer! ")
    put_text("")

    tips_nadvice = random.choice(tips_advice)
     
    style(put_text(tips_nadvice), 'color:red; font-size: 30px')
    
    put_text("")
    

def get_message(_):
    clear()
    show_buttons()

    put_html(
        '<p align="left>'
        '<h2>DevMotive</h2>'
        '</p>'
    )

    put_text("Your daily motivation for coding:")
    put_text("")
    
    message = random.choice(messages)
     
    style(put_text(message), 'color:blue; font-size: 30px')
    
    put_text("")
  
def get_challenge(_):
    clear()
    show_buttons()

    put_html(
        '<p align="left">'
        '<h2>DevMotive Challenges</h2>'
        '</p>'
    )

    put_text("Your daily coding challenege: ")
    put_text("")

    challenge = random.choice(challenges)

    style(put_text(challenge), 'color:pink; font-size: 30px')
    put_text("")


def get_quote(_):
    clear()
    show_buttons()

    put_html(
        '<p align="left">'
        '<h2>DevMotive Quotes</h2>'
        '</p>'

    )
    put_text("Coding Quotes: ")
    put_text("")
    quote = random.choice(quotes)

    style(put_text(quote), 'color:green; font-size: 30px')
    put_text("")


def app():
    put_html(
        '<p align="left">'
        '<h2>💻 DevMotive</h2>'
        '</p>'

    )
    show_buttons()
    hold()

def show_buttons():
    put_buttons([
        dict(label="Motivation", value='motivation', color='outline-success'),
        dict(label="Quote", value='quote', color='outline-primary'),
        dict(label="Challenege", value='challenge', color='outline-warning'),
        dict(label="Tips & Advice", value='tips_advice', color='outline-info'),
    ], onclick=button_click
    )

if __name__ == "__main__":
    start_server(app, port=8080, debug=True)
